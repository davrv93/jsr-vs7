{
  "name": "jsrbot-web",
  "description": "Consola web de jsrbot: bandeja, incidencias, equipo, indicadores, chat web de prueba y estado público",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build.types && npm run build.client && npm run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "mock": "node mock/servidor.mjs",
    "mock.dist": "SERVIR_DIST=1 node mock/servidor.mjs",
    "preview": "SERVIR_DIST=1 node mock/servidor.mjs",
    "test": "playwright test",
    "capturas": "node tests/capturas.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@builder.io/qwik": "1.20.1",
    "@builder.io/qwik-city": "1.20.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "undici": "^7.10.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
