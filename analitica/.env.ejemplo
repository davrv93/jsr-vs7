# jsrbot · analitica (ClickHouse). Copia a .env y rellena. .env esta en .gitignore: nunca se sube.
# Las claves NO van en ningun XML del repositorio: usuarios.xml las lee de estas variables.
#
# Genera cada clave y su hash asi (la clave en claro la usa el cliente; el hash lo lee ClickHouse):
#   clave=$(openssl rand -hex 24); echo "$clave"; printf %s "$clave" | shasum -a 256 | cut -d' ' -f1

# Usuario de ESCRITURA (el backend: carga por lotes desde la outbox y aplica esquema.sql).
JSR_CH_USUARIO=jsr
JSR_CH_CLAVE=CAMBIAR_clave_en_claro_del_backend
JSR_CH_CLAVE_SHA256=CAMBIAR_sha256_de_la_clave_anterior

# Usuario de SOLO LECTURA (golden queries, tableros y analista). Con limites de memoria, tiempo y filas.
JSR_CH_ANALISTA_USUARIO=analista
JSR_CH_ANALISTA_CLAVE=CAMBIAR_clave_en_claro_del_analista
JSR_CH_ANALISTA_CLAVE_SHA256=CAMBIAR_sha256_de_la_clave_anterior

# Conexion (HTTP). Dentro de la red de compose el servicio se llama jsrbot_clickhouse.
JSR_CH_URL=http://jsrbot_clickhouse:8123
JSR_CH_BASE=jsrbot

# Imagen usada y probada (ver analitica/LEEME.md). Se puede fijar a una etiqueta concreta.
JSR_CH_IMAGEN=clickhouse/clickhouse-server:26.9.10.4-alpine
