# pasarela · variables de entorno. COPIA este archivo a .env y rellena los valores. NUNCA subas el .env ni pegues aqui un valor real.
# Los secretos (JWT_SECRET, MOTOR_CLAVE, WEBHOOK_SECRET, EVOLUTION_API_KEY, DATABASE_URL con clave) se generan al desplegar, p. ej.:
#   openssl rand -hex 32

# --- Obligatorias: sin ellas la pasarela no arranca (lista todas las que falten) ---------------------------------------------
DATABASE_URL=                 # postgresql://usuario:CLAVE@host:5432/base
JWT_SECRET=                   # 32+ caracteres aleatorios; firma los tokens de la consola (HS256)
MOTOR_URL=                    # http://motor:8090  (red interna; el motor Go)
MOTOR_CLAVE=                  # la MISMA que el motor (cabecera X-Interno-Clave, 16+ caracteres)
AGENTE_URL=                   # http://agente:8000
WEBHOOK_SECRET=               # secreto de /webhook/evolution/<secreto> (o cabecera X-Webhook-Secret)

# --- WhatsApp (evolution-go). Por defecto SIMULADO: no se envia nada a nadie -----------------------------------------------------
EVOLUTION_MODO=simulado       # simulado | real. «real» exige las tres siguientes y envia a numeros reales
EVOLUTION_URL=                # http://evolution:8080            (solo con EVOLUTION_MODO=real)
EVOLUTION_API_KEY=            # token de la instancia             (solo con EVOLUTION_MODO=real)
EVOLUTION_INSTANCIA=          # nombre de la instancia            (solo con EVOLUTION_MODO=real)

# --- Publicas / seguridad ---------------------------------------------------------------------------------------------------------------
BASE_URL_PUBLICA=             # https://soporte.organizacion.pe/jsr  -> enlaces de estado: <BASE>/estado/<token>
CORS=                         # origenes de la consola separados por comas; vacio = sin origenes cruzados (con nginx delante no hace falta)
CONFIAR_PROXY=0               # 1 detras de nginx (X-Real-IP / ultima X-Forwarded-For)
CHAT_WEB=1                    # 0 apaga POST /api/chat-web (publico y crea personas e incidencias)
ANALITICA_TEXTO=0             # 1: el texto de los mensajes viaja a ClickHouse (privacidad: AGENTS §4)

# --- Opcionales (valores por defecto entre parentesis) --------------------------------------------------------------------------------
PORT=                         # (8080)
JWT_HORAS=                    # (12)
PBKDF2_ITER=                  # (600000)
SESION_HORAS=                 # (6)  silencio que abre un caso nuevo
AGENTE_TIMEOUT_S=             # (30)
MOTOR_TIMEOUT_S=              # (15)
EVOLUTION_TIMEOUT_S=          # (30)
SALIDA_ESPACIADO_MS=          # (900)  pausa entre mensajes a un mismo chat
HISTORIAL_TURNOS=             # (10)
RECORDATORIO_CIERRE_HORAS=    # (24)
RECORDATORIO_ENCUESTA_HORAS=  # (12)
ESTADO_CADUCA_DIAS=           # (30)
POOL_CONEXIONES=              # (8)
MIGRAR=                       # (1) 0 = no crear los indices propios al arrancar
TRABAJADORES=                 # (1) 0 = sin avisos, recordatorios, conocimiento inicial ni sondeo de eventos

# --- Solo para `pasarela crear-admin` (nunca por argumento; no la dejes en el .env de produccion) ------------------------------------
# PASARELA_ADMIN_CLAVE=
